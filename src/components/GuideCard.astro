---
import type { Guide } from '../lib/types';
import StarRating from './StarRating.astro';

interface Props {
  guide: Guide;
  rating?: number;
  reviewCount?: number;
}
const { guide, rating, reviewCount } = Astro.props;
const initials = guide.name.split(/\s+/).map((part) => part[0]).join('').slice(0, 2).toUpperCase();
const hasPhoto = Boolean(guide.photo_url && !guide.photo_url.includes('guide-placeholder'));
---
<a href={`/guides/${guide.slug}`} class="card-hover group block p-5">
  <div class="flex items-center gap-4">
    {hasPhoto ? (
      <img
        src={guide.photo_url!}
        alt={guide.name}
        loading="lazy"
        decoding="async"
        onerror="this.onerror=null;this.src='/images/guide-placeholder.svg'"
        class="h-16 w-16 flex-none rounded-full object-cover ring-2 ring-gold/20"
      />
    ) : (
      <div class="flex h-16 w-16 flex-none items-center justify-center rounded-full bg-forest/10 font-serif text-lg font-bold text-forest ring-2 ring-gold/20" aria-hidden="true">
        {initials}
      </div>
    )}
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="font-serif text-base font-semibold text-forest">{guide.name}</h3>
        <span class="rounded-full bg-forest/8 px-2 py-0.5 text-[10px] font-semibold text-forest">License verified</span>
      </div>
      {rating !== undefined && rating > 0
        ? <div class="mt-0.5"><StarRating rating={rating} count={reviewCount} size={13} /></div>
        : <p class="mt-0.5 text-xs text-forest/45">New guide</p>}
      <p class="mt-1 text-xs text-forest/55">
        {guide.years_experience}+ years · {(guide.languages ?? []).slice(0, 3).join(', ')}
      </p>
    </div>
  </div>
  {guide.bio && <p class="mt-4 line-clamp-2 text-sm leading-relaxed text-forest/65">{guide.bio}</p>}
  {guide.certifications?.length > 0 && (
    <p class="mt-3 text-xs font-medium text-gold-dark">{guide.certifications[0]}</p>
  )}
</a>
