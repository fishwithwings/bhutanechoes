---
import Layout from '../layouts/Layout.astro';
import TourCard from '../components/TourCard.astro';
import { getTours } from '../lib/data';

// Keep the homepage on the same live catalogue and tier prices as /tours.
export const prerender = false;

const env = (Astro.locals as any).runtime?.env;
const tours = await getTours(env);
const counts: Record<string, number> = {};
const featuredReviews: never[] = [];
const FEATURED_SLUGS = [
  'essential-bhutan-7d', 'punakha-tshechu-9d', 'uma-paro-luxury-5d',
  'western-bhutan-grand-tour', 'tigers-nest-hike', 'druk-path-trek',
];
const prioritizedTours = FEATURED_SLUGS
  .map((slug) => tours.find((tour) => tour.slug === slug))
  .filter(Boolean) as typeof tours;
const featuredTours = [...prioritizedTours, ...tours.filter((tour) => !FEATURED_SLUGS.includes(tour.slug))].slice(0, 3);

const steps = [
  { n: '1', t: 'Choose your tour', d: `Compare ${tours.length} all-inclusive Bhutan journeys by travel style, length, and price.` },
  { n: '2', t: 'Send your request', d: 'Share your dates, group size, preferred package, and anything that matters to you.' },
  { n: '3', t: 'We arrange your match', d: 'Our local team recommends an itinerary and introduces the right licensed guide for your trip.' },
  { n: '4', t: 'Confirm when ready', d: 'Ask questions, refine the plan, and only confirm once the itinerary and guide feel right.' },
];

const trust = [
  { stat: String(tours.length), label: 'Curated Bhutan journeys' },
  { stat: 'Personal', label: 'Local guide matching' },
  { stat: '3', label: 'All-inclusive tiers' },
  { stat: '< 24h', label: 'Trip-planning replies' },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://bhutanechoes.com/#website",
      "url": "https://bhutanechoes.com",
      "name": "Bhutan Echoes",
      "description": "Plan Bhutan tours and treks with local guide matching.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "https://bhutanechoes.com/tours?q={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://bhutanechoes.com/#organization",
      "url": "https://bhutanechoes.com",
      "name": "Bhutan Echoes",
      "description": "A growing Bhutan tour marketplace that personally matches travelers with licensed local guides.",
      "logo": { "@type": "ImageObject", "url": "https://bhutanechoes.com/logo.svg" },
      "areaServed": { "@type": "Country", "name": "Bhutan" },
      "knowsAbout": ["Bhutan tours", "Bhutan trekking", "Tiger's Nest hike", "Bhutan festival tours", "Licensed Bhutan guides"],
      "sameAs": []
    }
  ]
};
---
<Layout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img src="https://images.unsplash.com/photo-1584095434749-d1b975e1ca9c?w=1600&q=80" alt="" class="h-full w-full object-cover" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-b from-forest-900/70 via-forest-900/55 to-forest-900/80"></div>
    </div>
    <div class="container-x flex min-h-[78vh] flex-col justify-center py-24 text-cream">
      <p class="eyebrow text-gold-light">The last Himalayan kingdom</p>
      <h1 class="mt-3 max-w-3xl font-serif text-4xl font-bold leading-[1.1] text-cream sm:text-6xl">
        Travel Bhutan with a guide who calls it home.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-cream/85">
        Explore {tours.length} all-inclusive journeys, then tell us your plans. Our local team will
        arrange the right licensed guide for you.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/tours" class="btn-gold text-base">Explore tours</a>
        <a href="/plan" class="btn-outline border-cream/40 text-cream hover:bg-cream/10 hover:border-cream">
          Help me choose
        </a>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="border-b border-forest/10 bg-cream-dark">
    <div class="container-x grid grid-cols-2 gap-6 py-8 md:grid-cols-4">
      {trust.map((t) => (
        <div class="text-center">
          <p class="font-serif text-2xl font-bold text-forest">{t.stat}</p>
          <p class="mt-1 text-xs uppercase tracking-wide text-forest/55">{t.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured tours -->
  <section class="container-x py-20">
    <div class="flex items-end justify-between">
      <div>
        <p class="eyebrow">Signature journeys</p>
        <h2 class="mt-2 font-serif text-3xl font-bold sm:text-4xl">Featured tours</h2>
      </div>
      <a href="/tours#tours" class="btn-ghost hidden sm:inline-flex">View all tours →</a>
    </div>
    <div class="mt-10 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {featuredTours.map((tour) => <TourCard tour={tour} guideCount={counts[tour.id]} />)}
    </div>
    <div class="mt-8 text-center sm:hidden">
      <a href="/tours#tours" class="btn-outline">View all tours</a>
    </div>
  </section>

  <!-- Planning guides -->
  <section class="bg-cream-dark">
    <div class="container-x py-20">
      <div class="max-w-2xl">
        <p class="eyebrow">Before you book</p>
        <h2 class="mt-2 font-serif text-3xl font-bold sm:text-4xl">Plan Bhutan with confidence</h2>
        <p class="mt-3 text-forest/70">Understand the seasons, visa process, Sustainable Development Fee, and real trip costs before choosing an itinerary.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <a href="/travel-guide/bhutan-visa-sdf-fee-explained" class="card-hover block p-6">
          <p class="text-sm font-semibold text-gold-dark">Entry and fees</p>
          <h3 class="mt-2 font-serif text-xl font-semibold">Bhutan visa and SDF explained</h3>
          <p class="mt-2 text-sm leading-relaxed text-forest/65">What the daily fee covers, how the visa works, and what to prepare.</p>
        </a>
        <a href="/travel-guide/best-time-to-visit-bhutan" class="card-hover block p-6">
          <p class="text-sm font-semibold text-gold-dark">Weather and festivals</p>
          <h3 class="mt-2 font-serif text-xl font-semibold">The best time to visit Bhutan</h3>
          <p class="mt-2 text-sm leading-relaxed text-forest/65">Choose a month for clear mountain views, spring blooms, or festival days.</p>
        </a>
        <a href="/plan" class="rounded-2xl bg-forest p-6 text-cream shadow-sm">
          <p class="text-sm font-semibold text-gold-light">Personal trip help</p>
          <h3 class="mt-2 font-serif text-xl font-semibold text-cream">Tell us how you want to travel</h3>
          <p class="mt-2 text-sm leading-relaxed text-cream/70">Share your dates, group size, and interests. We’ll suggest a suitable itinerary.</p>
          <span class="mt-5 inline-flex text-sm font-semibold text-cream">Plan my trip →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-forest text-cream">
    <div class="container-x py-20">
      <p class="eyebrow text-gold-light text-center">Simple & transparent</p>
      <h2 class="mt-2 text-center font-serif text-3xl font-bold text-cream sm:text-4xl">How it works</h2>
      <div class="mt-14 grid gap-10 md:grid-cols-4">
        {steps.map((s) => (
          <div class="relative">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gold font-serif text-lg font-bold text-white">
              {s.n}
            </div>
            <h3 class="mt-5 font-serif text-xl font-semibold text-cream">{s.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream/70">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reviews -->
  {featuredReviews.length > 0 && (
    <section class="bg-cream-dark">
      <div class="container-x py-20">
        <p class="eyebrow text-center">Traveler stories</p>
        <h2 class="mt-2 text-center font-serif text-3xl font-bold sm:text-4xl">What guests say</h2>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredReviews.map((r: any) => (
            <div class="card p-6">
              <div class="flex gap-0.5 text-gold">
                {'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}
              </div>
              <p class="mt-3 text-sm leading-relaxed text-forest/80 line-clamp-4">{r.comment}</p>
              <div class="mt-4 border-t border-forest/8 pt-4">
                <p class="text-sm font-semibold">{r.author_name}</p>
                {r.guide_name && <p class="text-xs text-forest/50">Tour with {r.guide_name}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- For guides CTA -->
  <section class="container-x py-20">
    <div class="card grid items-center gap-8 overflow-hidden md:grid-cols-2">
      <div class="p-10">
        <p class="eyebrow">For licensed guides</p>
        <h2 class="mt-2 font-serif text-3xl font-bold">Guide travelers. Set your own price. Get paid fairly.</h2>
        <p class="mt-4 text-forest/70">
          Join the founding Bhutan Echoes network, build your profile, and help us
          shape a fairer way for travelers and licensed guides to meet.
        </p>
        <a href="/for-guides" class="btn-primary mt-6">Apply to guide</a>
      </div>
      <div class="relative h-64 md:h-full md:min-h-[320px]">
        <img src="https://images.unsplash.com/photo-1638245771029-9bdb1e3e7a01?w=1200&q=80" alt="" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>
</Layout>
