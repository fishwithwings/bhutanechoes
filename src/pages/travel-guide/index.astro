---
import Layout from '../../layouts/Layout.astro';
export const prerender = true;

const articles = [
  {
    slug: 'bhutan-visa-sdf-fee-explained',
    title: 'Bhutan Visa & SDF Fee, Explained',
    summary: "What the Sustainable Development Fee actually pays for, how much you'll owe, and how the visa process works for a Bhutan trip.",
  },
  {
    slug: 'best-time-to-visit-bhutan',
    title: 'Best Time to Visit Bhutan',
    summary: 'A month-by-month breakdown of weather, festivals and trekking conditions to help you pick your travel dates.',
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Bhutan Travel Guide",
  "description": "Practical guides to planning a Bhutan trip — visas, fees, best time to visit, and more.",
  "url": "https://bhutanechoes.com/travel-guide",
};
---
<Layout
  title="Bhutan Travel Guide — Visas, Fees & Planning Tips | Bhutan Echoes"
  description="Practical guides for planning your Bhutan trip: visa & SDF fees, best time to visit, and more — written for travelers booking directly with a local guide."
  jsonLd={jsonLd}
>
  <section class="bg-cream-dark border-b border-forest/10">
    <div class="container-x py-14">
      <p class="eyebrow">Plan your trip</p>
      <h1 class="mt-2 font-serif text-4xl font-bold sm:text-5xl">Bhutan travel guide</h1>
      <p class="mt-3 max-w-2xl text-forest/70">
        Everything you need to know before you book — visas, fees, timing and more.
      </p>
    </div>
  </section>

  <section class="container-x py-12">
    <div class="grid gap-6 sm:grid-cols-2">
      {articles.map((a) => (
        <a href={`/travel-guide/${a.slug}`} class="card-hover card block p-6">
          <h2 class="font-serif text-xl font-semibold text-forest">{a.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-forest/65">{a.summary}</p>
          <span class="mt-4 inline-block text-sm font-medium text-gold-dark">Read more →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
