---
import Layout from '../../layouts/Layout.astro';
export const prerender = true;

const months = [
  { m: 'Mar – May (Spring)', d: 'Rhododendrons bloom across the valleys and trekking trails are clear. Warm days, cool nights. The best window for the Druk Path and Jumolhari treks.', tag: 'Best for trekking' },
  { m: 'Jun – Aug (Summer/Monsoon)', d: 'Warm and rainy, with lush green valleys. Fewer crowds and lower demand for guides. Good for cultural touring in Thimphu and Punakha if you don’t mind occasional rain.', tag: 'Best for value & quiet' },
  { m: 'Sep – Nov (Autumn)', d: 'Clear skies, crisp air, and Bhutan’s festival season — including Thimphu Tshechu and Paro Tshechu. The most popular and most booked-up season.', tag: 'Best for festivals' },
  { m: 'Dec – Feb (Winter)', d: 'Cold at altitude but sunny and dry in the valleys. Black-necked cranes migrate to Phobjikha. Fewer tourists, lower guide availability, but stunning mountain visibility.', tag: 'Best for photography' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Best Time to Visit Bhutan",
      "description": "A month-by-month breakdown of weather, festivals and trekking conditions to help you pick your Bhutan travel dates.",
      "url": "https://bhutanechoes.com/travel-guide/best-time-to-visit-bhutan",
      "author": { "@type": "Organization", "name": "Bhutan Echoes" },
      "publisher": { "@type": "Organization", "name": "Bhutan Echoes" },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://bhutanechoes.com" },
        { "@type": "ListItem", "position": 2, "name": "Travel Guide", "item": "https://bhutanechoes.com/travel-guide" },
        { "@type": "ListItem", "position": 3, "name": "Best Time to Visit Bhutan", "item": "https://bhutanechoes.com/travel-guide/best-time-to-visit-bhutan" },
      ],
    },
  ],
};
---
<Layout
  title="Best Time to Visit Bhutan — Month-by-Month Guide | Bhutan Echoes"
  description="When should you visit Bhutan? A month-by-month guide to weather, festival season and trekking conditions to help you plan your trip."
  jsonLd={jsonLd}
>
  <section class="bg-cream-dark border-b border-forest/10">
    <div class="container-x py-12">
      <a href="/travel-guide" class="text-sm text-forest/55 hover:text-gold-dark">← Travel guide</a>
      <p class="eyebrow mt-3">Planning</p>
      <h1 class="mt-2 max-w-2xl font-serif text-4xl font-bold sm:text-5xl">Best time to visit Bhutan</h1>
      <p class="mt-3 max-w-2xl text-forest/70">
        Bhutan rewards visitors year-round, but your ideal month depends on whether you're chasing festivals,
        clear trekking trails, or fewer crowds.
      </p>
    </div>
  </section>

  <section class="container-x max-w-3xl py-12">
    <div class="space-y-8 leading-relaxed text-forest/80">
      <p>
        Bhutan's high-altitude valleys mean the seasons shift more sharply than in most of South Asia — spring and
        autumn are the most popular (and most booked-up) windows, but summer and winter each have real advantages
        if you know what to expect.
      </p>

      <div class="space-y-5">
        {months.map((s) => (
          <div class="card p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="font-serif text-lg font-semibold text-forest">{s.m}</h2>
              <span class="pill-gold">{s.tag}</span>
            </div>
            <p class="mt-2 text-sm text-forest/70">{s.d}</p>
          </div>
        ))}
      </div>

      <div>
        <h2 class="font-serif text-2xl font-semibold text-forest">Planning around festivals</h2>
        <p class="mt-3">
          Bhutan's tshechus (masked-dance festivals) are the country's biggest draw for autumn travelers, and
          guide availability books out months in advance for Thimphu and Paro Tshechu. If a festival is the goal,
          lock in your guide early rather than waiting until a few weeks out.
        </p>
      </div>

      <div>
        <h2 class="font-serif text-2xl font-semibold text-forest">Planning around trekking</h2>
        <p class="mt-3">
          Spring (March–May) and autumn (late September–November) are the two dry, clear windows for high-altitude
          treks like Druk Path and Jumolhari. Summer's monsoon rains make trails muddy and views unreliable; winter
          brings snow at higher passes, though lower-altitude cultural touring stays comfortable year-round.
        </p>
      </div>

      <div class="rounded-2xl bg-forest/5 p-6">
        <h2 class="font-serif text-xl font-semibold text-forest">Find a tour for your season</h2>
        <p class="mt-2 text-forest/70">
          Every guide on Bhutan Echoes lists their real availability, so you can see exactly who's free for your
          dates before you book.
        </p>
        <a href="/tours" class="btn-primary mt-4 inline-block">Browse all tours</a>
      </div>
    </div>
  </section>
</Layout>
