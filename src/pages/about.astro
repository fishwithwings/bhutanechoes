---
import Layout from '../layouts/Layout.astro';
export const prerender = true;

const steps = [
  { n: '1', t: 'Choose your tour', d: 'Compare our curated Bhutan tours and treks, each with three clearly priced package levels.' },
  { n: '2', t: 'Send your trip request', d: 'Share your preferred dates, group size, package level, interests, and questions.' },
  { n: '3', t: 'Get a personal match', d: 'Our local team recommends an itinerary and arranges a suitable licensed guide.' },
  { n: '4', t: 'Confirm the details', d: 'Meet your guide, refine the plan, and confirm only when everything feels right.' },
  { n: '5', t: 'Travel', d: 'Meet your guide in Bhutan and experience the kingdom through the eyes of someone who lives it.' },
];
const faqs = [
  { q: 'Who sets the prices?', a: 'Bhutan Echoes sets one transparent price for each Essential, Classic, and Luxury package. The same package price appears across the catalogue and tour page.' },
  { q: 'Are the guides licensed?', a: 'We only arrange matches with licensed Bhutanese guides. We confirm the guide with you personally before you make a booking decision.' },
  { q: 'How are payments handled?', a: 'Online payment is not open during this early launch. After we agree on your itinerary and guide, we will explain the confirmation and payment steps clearly.' },
  { q: 'Is the price per person or per group?', a: 'Prices are shown per person. Your total is the per-person price multiplied by your group size.' },
  { q: 'Can I cancel?', a: "Cancellation terms depend on the tour and timing. Contact us and we'll coordinate with your guide." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<Layout title="How it works — Bhutan Echoes" description="Browse Bhutan tours, send your trip request, and let our local team arrange the right licensed guide." jsonLd={jsonLd}>
  <section class="bg-cream-dark border-b border-forest/10">
    <div class="container-x py-14">
      <p class="eyebrow">How it works</p>
      <h1 class="mt-2 font-serif text-4xl font-bold sm:text-5xl">Fair, direct, unforgettable</h1>
      <p class="mt-3 max-w-2xl text-forest/70">
        Bhutan Echoes is building a direct marketplace for travelers and licensed
        local guides. During our early launch, we arrange each guide match personally.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gold font-serif text-lg font-bold text-white">{s.n}</div>
          <h3 class="mt-4 font-serif text-xl font-semibold">{s.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-forest/70">{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-cream-dark">
    <div class="container-x py-16">
      <h2 class="font-serif text-3xl font-bold">Frequently asked questions</h2>
      <div class="mt-8 max-w-3xl divide-y divide-forest/10">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-forest">
              {f.q}
              <span class="text-gold transition-transform group-open:rotate-45 text-xl">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-forest/70">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
