---
import Layout from '../../layouts/Layout.astro';
import TourCard from '../../components/TourCard.astro';
import { getTours, getGuideCounts } from '../../lib/data';

export const prerender = false;

const env = (Astro.locals as any).runtime?.env;
const tours = await getTours(env);
const counts = await getGuideCounts(env);

const regionCandidates = ['Paro', 'Thimphu', 'Punakha', 'Bumthang', 'Phobjikha', 'Haa Valley', 'Gasa', 'Laya'];
const regions = regionCandidates.filter((region) =>
  tours.some((tour) => tour.region?.toLowerCase().includes(region.toLowerCase()))
);
const isTrek = (tour: typeof tours[number]) =>
  ['trekking', 'adventure'].includes(tour.tour_type ?? '') || tour.slug.includes('trek') || tour.slug.includes('hike');
const trekTours = tours.filter(isTrek);
const generalTours = tours.filter((tour) => !isTrek(tour));

const POPULAR_SLUGS = [
  'essential-bhutan-7d',
  'punakha-tshechu-9d',
  'uma-paro-luxury-5d',
  'tigers-nest-hike',
  'punakha-day-tour',
  'druk-path-trek',
];
const preferredTours = POPULAR_SLUGS.map(s => tours.find(t => t.slug === s)).filter(Boolean) as typeof tours;
const popularTours = [...preferredTours, ...tours.filter((tour) => !POPULAR_SLUGS.includes(tour.slug))].slice(0, 3);

const listingJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "name": "Bhutan Tours & Treks",
      "description": "Bhutan tours and treks with personal licensed-guide matching — cultural journeys, festival tours, luxury lodges and Himalayan expeditions.",
      "url": "https://bhutanechoes.com/tours",
      "numberOfItems": tours.length,
      "itemListElement": tours.map((t, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `https://bhutanechoes.com/tours/${t.slug}`,
        "name": t.name,
      })),
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://bhutanechoes.com" },
        { "@type": "ListItem", "position": 2, "name": "Tours & Treks", "item": "https://bhutanechoes.com/tours" },
      ],
    },
  ],
};
---
<Layout title="Bhutan Tours & Treks — Request a Local Guide | Bhutan Echoes"
        description="Browse 10+ Bhutan tours and treks, then send your plans to our local team for a personal licensed-guide match."
        jsonLd={listingJsonLd}>
  <section class="bg-cream-dark border-b border-forest/10">
    <div class="container-x py-10 sm:py-14">
      <p class="eyebrow">Our catalogue</p>
      <h1 class="mt-2 font-serif text-4xl font-bold sm:text-5xl">Tours &amp; treks</h1>
      <p class="mt-3 max-w-2xl text-forest/70">
        Pick a journey and send us your plans. We’ll arrange the right licensed guide — with all-inclusive packages from Essential to Luxury.
      </p>
    </div>
  </section>

  <!-- Filters -->
  <section class="sticky top-16 z-20 border-b border-forest/10 bg-white/95 backdrop-blur" id="find-your-trip">
    <div class="container-x py-3">
      <div class="flex items-center gap-3">
      <input id="search-input" type="search" placeholder="Search tours…"
             aria-label="Search tours" class="input min-w-0 flex-1 !py-2 text-sm md:max-w-56" />

      <button id="filters-toggle" type="button" class="inline-flex min-h-10 items-center justify-center rounded-xl border border-forest/15 bg-white px-4 text-sm font-medium text-forest md:hidden" aria-expanded="false" aria-controls="advanced-filters">
        Filters
      </button>

      <span id="filter-count" class="hidden text-xs text-forest/50 sm:inline"></span>
      <button id="filter-clear" class="hidden min-h-10 rounded-xl px-3 text-xs font-semibold text-forest hover:bg-forest/5">Clear</button>
      </div>

      <div id="advanced-filters" class="mt-3 hidden grid-cols-2 gap-3 md:grid md:grid-cols-5">

      <select id="filter-region" aria-label="Region" class="input !py-2 text-sm">
        <option value="">All regions</option>
        {regions.map((r) => <option value={r.toLowerCase()}>{r}</option>)}
      </select>

      <select id="filter-difficulty" aria-label="Difficulty" class="input !py-2 text-sm">
        <option value="">Any difficulty</option>
        <option value="easy">Easy</option>
        <option value="moderate">Moderate</option>
        <option value="challenging">Challenging</option>
        <option value="strenuous">Strenuous</option>
      </select>

      <select id="filter-duration" aria-label="Trip length" class="input !py-2 text-sm">
        <option value="">Any length</option>
        <option value="1">Day trip (1 day)</option>
        <option value="2-4">Short (2–4 days)</option>
        <option value="5-8">Medium (5–8 days)</option>
        <option value="9+">Long (9+ days)</option>
      </select>

      <select id="filter-type" aria-label="Travel style" class="input !py-2 text-sm">
        <option value="">All types</option>
        <option value="cultural">Cultural</option>
        <option value="festival">Festival</option>
        <option value="luxury">Luxury</option>
        <option value="trekking">Trekking</option>
        <option value="adventure">Adventure</option>
      </select>

      <select id="filter-tier" aria-label="Starting budget" class="input !py-2 text-sm">
        <option value="">Any starting price</option>
        <option value="under-500">Under $500</option>
        <option value="500-1499">$500–$1,499</option>
        <option value="1500-plus">$1,500+</option>
      </select>
      </div>
    </div>
  </section>

  <!-- Traveler favorites -->
  {popularTours.length > 0 && <section class="container-x py-10 border-b border-forest/10 sm:py-12">
    <div class="flex items-center gap-3 mb-1">
      <h2 class="font-serif text-2xl font-semibold text-forest">Traveler favorites</h2>
      <span class="pill-gold text-xs">Most popular</span>
    </div>
    <p class="text-forest/60 text-sm mb-7">Three good starting points for a first Bhutan journey.</p>
    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {popularTours.map((tour) => (
        <div>
          <TourCard tour={tour} guideCount={counts[tour.id]} />
        </div>
      ))}
    </div>
  </section>}

  <section class="container-x py-14">
    <!-- Tours section -->
    <div id="tours">
      <h2 class="font-serif text-2xl font-semibold text-forest mb-1">Tours</h2>
      <p class="text-forest/60 text-sm mb-7">Cultural journeys, day trips and multi-day touring packages.</p>
      <div id="tours-grid" class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {generalTours.map((tour) => (
          <div
            class="tour-card"
            data-slug={tour.slug}
            data-name={tour.name.toLowerCase()}
            data-region={tour.region ?? ''}
            data-difficulty={tour.difficulty ?? ''}
            data-duration={tour.duration_days}
            data-min-price={tour.min_price_cents}
            data-summary={tour.summary?.toLowerCase() ?? ''}
            data-type={tour.tour_type ?? ''}
            data-kind="tour"
          >
            <TourCard tour={tour} guideCount={counts[tour.id]} />
          </div>
        ))}
      </div>
      <p id="no-results-tours" class="hidden mt-8 text-sm text-forest/50">No tours match your filters.</p>
    </div>

    <!-- Hikes section -->
    {trekTours.length > 0 && <div id="hikes" class="mt-16 scroll-mt-24">
      <h2 class="font-serif text-2xl font-semibold text-forest mb-1">Hikes &amp; treks</h2>
      <p class="text-forest/60 text-sm mb-7">On-foot adventures from a half-day climb to a 13-day Himalayan expedition.</p>
      <div id="treks-grid" class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {trekTours.map((tour) => (
          <div
            class="tour-card"
            data-slug={tour.slug}
            data-name={tour.name.toLowerCase()}
            data-region={tour.region ?? ''}
            data-difficulty={tour.difficulty ?? ''}
            data-duration={tour.duration_days}
            data-min-price={tour.min_price_cents}
            data-summary={tour.summary?.toLowerCase() ?? ''}
            data-type={tour.tour_type ?? ''}
            data-kind="trek"
          >
            <TourCard tour={tour} guideCount={counts[tour.id]} />
          </div>
        ))}
      </div>
      <p id="no-results-treks" class="hidden mt-8 text-sm text-forest/50">No hikes match your filters.</p>
    </div>}

    <p id="no-results" class="hidden mt-16 text-center text-forest/55">No results match your filters. <button id="clear-all" class="underline">Clear all</button></p>
  </section>
</Layout>

<script>
  const search   = document.getElementById('search-input') as HTMLInputElement;
  const region   = document.getElementById('filter-region') as HTMLSelectElement;
  const diff     = document.getElementById('filter-difficulty') as HTMLSelectElement;
  const duration = document.getElementById('filter-duration') as HTMLSelectElement;
  const typeEl   = document.getElementById('filter-type') as HTMLSelectElement;
  const tier     = document.getElementById('filter-tier') as HTMLSelectElement;
  const count    = document.getElementById('filter-count')!;
  const clearBtn = document.getElementById('filter-clear')!;
  const noRes    = document.getElementById('no-results')!;
  const noResTours = document.getElementById('no-results-tours')!;
  const noResTreks = document.getElementById('no-results-treks')!;
  const clearAll = document.getElementById('clear-all')!;
  const cards    = Array.from(document.querySelectorAll('.tour-card')) as HTMLElement[];

  const filtersToggle = document.getElementById('filters-toggle') as HTMLButtonElement;
  const advancedFilters = document.getElementById('advanced-filters')!;

  function filter() {
    const q = search.value.toLowerCase().trim();
    const r = region.value;
    const d = diff.value;
    const dur = duration.value;
    const tp = typeEl.value;
    const t = tier.value;

    const hasFilter = q || r || d || dur || tp || t;
    clearBtn.classList.toggle('hidden', !hasFilter);

    let visibleTours = 0;
    let visibleTreks = 0;

    cards.forEach((card) => {
      const name    = card.dataset.name ?? '';
      const summary = card.dataset.summary ?? '';
      const days    = parseInt(card.dataset.duration ?? '0', 10);
      const price   = parseInt(card.dataset.minPrice ?? '0', 10);
      const isTrek  = card.dataset.kind === 'trek';

      const matchQ  = !q  || name.includes(q) || summary.includes(q);
      const matchR  = !r  || (card.dataset.region ?? '').toLowerCase().includes(r);
      const matchD  = !d  || card.dataset.difficulty === d;
      const matchTp = !tp || card.dataset.type === tp;
      const matchT  = !t
        || (t === 'under-500' && price < 50_000)
        || (t === '500-1499' && price >= 50_000 && price < 150_000)
        || (t === '1500-plus' && price >= 150_000);
      let matchDur = true;
      if (dur === '1') matchDur = days === 1;
      else if (dur === '2-4') matchDur = days >= 2 && days <= 4;
      else if (dur === '5-8') matchDur = days >= 5 && days <= 8;
      else if (dur === '9+') matchDur = days >= 9;

      const show = matchQ && matchR && matchD && matchTp && matchT && matchDur;
      card.classList.toggle('hidden', !show);
      if (show) isTrek ? visibleTreks++ : visibleTours++;
    });

    const total = visibleTours + visibleTreks;
    count.textContent = hasFilter ? `${total} of ${cards.length} results` : '';
    noResTours.classList.toggle('hidden', visibleTours > 0);
    noResTreks?.classList.toggle('hidden', visibleTreks > 0);
    noRes.classList.toggle('hidden', total > 0);
  }

  [search, region, diff, duration, typeEl, tier].forEach((el) => el.addEventListener('input', filter));
  filtersToggle?.addEventListener('click', () => {
    const opening = advancedFilters.classList.contains('hidden');
    advancedFilters.classList.toggle('hidden', !opening);
    advancedFilters.classList.toggle('grid', opening);
    filtersToggle.setAttribute('aria-expanded', String(opening));
    filtersToggle.textContent = opening ? 'Hide filters' : 'Filters';
  });

  function clearFilters() {
    search.value = ''; region.value = ''; diff.value = ''; duration.value = ''; typeEl.value = ''; tier.value = '';
    filter();
  }
  clearBtn.addEventListener('click', clearFilters);
  clearAll.addEventListener('click', clearFilters);
</script>
